# Optional: enables weather commands.
OPENWEATHER_API_KEY=your_openweather_api_key

# Choose `ollama` for private local processing (default), `openai`, or `aimlapi`.
# Never commit your real .env file.
FRIDAY_LLM_PROVIDER=ollama

# Fast local default. Change this only to a model you have already pulled.
FRIDAY_MODEL=qwen3.5:4b

# Optional cloud provider. Fill this in only when FRIDAY_LLM_PROVIDER=openai.
OPENAI_API_KEY=
FRIDAY_OPENAI_MODEL=gpt-4.1-mini

# AIMLAPI: use a model from its 1000+ model catalogue.
AIMLAPI_KEY=
FRIDAY_AIMLAPI_MODEL=openai/gpt-5-5

# Shorter answers make the assistant feel much faster. Raise only if needed.
FRIDAY_MAX_TOKENS=220

# Native desktop voice options (macOS `say` voices). The web UI has its own
# Male/Female selector and uses the voices installed in your browser/OS.
FRIDAY_VOICE_PROFILE=female
FRIDAY_VOICE_MALE=Alex
FRIDAY_VOICE_FEMALE=Samantha
# Optional: install a Hindi macOS voice and place its exact name here.
FRIDAY_VOICE_HINDI=
FRIDAY_VOICE_RATE=185
