# Optional: enables weather commands.
OPENWEATHER_API_KEY=your_openweather_api_key

# Local Ollama model. Change this only to a model you have already installed.
FRIDAY_MODEL=qwen3.5:9b

# Shorter answers make the assistant feel much faster. Raise only if needed.
FRIDAY_MAX_TOKENS=220

# Native desktop voice options (macOS `say` voices). The web UI has its own
# Male/Female selector and uses the voices installed in your browser/OS.
FRIDAY_VOICE_PROFILE=female
FRIDAY_VOICE_MALE=Alex
FRIDAY_VOICE_FEMALE=Samantha
# Optional: install a Hindi macOS voice and place its exact name here.
FRIDAY_VOICE_HINDI=
FRIDAY_VOICE_RATE=185
